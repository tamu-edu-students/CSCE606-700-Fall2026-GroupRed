<h1>Swipe Page</h1>

<% if @prospect %>
  <h2><%= @prospect.display_name %></h2>
  <p>Bio: <%= @prospect.bio %></p>
  <p>Age: <%= @prospect.age %></p>
  <p>Gender: <%= @prospect.gender %></p>

  <%= render "companion_reaction", companion: @companion, reaction: @reaction, messages: @messages, profile: @prospect %>

  <%= button_to "Like", swipes_path(prospect_id: @prospect.id, action_type: "like"), method: :post %>
  <%= button_to "Dislike", swipes_path(prospect_id: @prospect.id, action_type: "dislike"), method: :post %>

<% else %>
  <p>No more profiles available.</p>
<% end %>

<%= button_to "Undo Last Swipe", undo_swipes_path, method: :post,
      form: { onsubmit: "return confirm('Are you sure you want to undo your last swipe?');" } %>

<%= link_to "View Swipe History", history_index_path %>