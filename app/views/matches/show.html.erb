<% content_for :title, "Messages with #{@other_profile.display_name}" %>

<section class="conversation" aria-labelledby="conversation-heading">
  <h1 id="conversation-heading">Messages with <%= @other_profile.display_name %></h1>
  <p>
    <%= link_to "Back to matches", matches_path %> |
    <%= link_to "View #{@other_profile.display_name}'s profile", person_path(@other_profile.user) %>
  </p>

  <% if @messages.any? %>
    <ol class="conversation-messages">
      <% @messages.each do |message| %>
        <% mine = message.sender_id == @profile.id %>
        <li class="<%= mine ? "message-mine" : "message-theirs" %>">
          <strong><%= mine ? "You" : message.sender.display_name %>:</strong>
          <%= message.body %>
          <time datetime="<%= message.created_at.iso8601 %>"><%= l(message.created_at, format: :short) %></time>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p>No messages yet. Say hi to <%= @other_profile.display_name %>!</p>
  <% end %>

  <section class="opener-ideas" aria-labelledby="opener-ideas-heading">
    <h2 id="opener-ideas-heading">Not sure what to say?</h2>
    <% if @openers.any? %>
      <ul>
        <% @openers.each do |opener| %>
          <li>
            <%= opener %>
            <%= link_to "Use this", match_path(@match, draft: opener) %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <%= button_to "Help me start", match_openers_path(@match) %>
  </section>

  <%= form_with url: match_messages_path(@match), local: true do |form| %>
    <%= form.label :body, "Message #{@other_profile.display_name}" %>
    <%= form.text_area :body, value: @draft, maxlength: Message::MAX_LENGTH, required: true, rows: 3 %>
    <%= form.submit "Send" %>
  <% end %>
</section>

