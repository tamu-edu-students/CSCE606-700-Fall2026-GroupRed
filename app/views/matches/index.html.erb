<h1>Matches</h1>
<% if @matches.any? %>
  <ul class="match-list">
    <% @matches.each do |match| %>
      <% other_profile = match.other_profile(@profile) %>
      <li>
        <h2><%= other_profile.display_name %></h2>
        <p>Bio: <%= other_profile.bio %></p>
        <p>Age: <%= other_profile.age %></p>
        <p>Gender: <%= other_profile.gender %></p>
        <p><%= link_to "Message #{other_profile.display_name}", match_path(match) %></p>
        <p><%= link_to "View #{other_profile.display_name}'s profile", person_path(other_profile.user) %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>No matches yet.</p>
<% end %>