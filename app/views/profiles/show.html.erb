<% content_for :title, "My profile" %>

<section class="profile" aria-labelledby="profile-name">
  <h1 id="profile-name"><%= @profile.display_name %></h1>

  <%= render "profiles/photo", profile: @profile %>
  
  <p><%= @profile.age %> years old</p>

  <dl>
    <dt>Gender</dt>
    <dd><%= @profile.gender.presence || "Not set" %></dd>

    <dt>Interested in</dt>
    <dd><%= @profile.interested_in.presence || "Not set" %></dd>

    <dt>Age range</dt>
    <dd><%= @profile.age_min || "Any" %> to <%= @profile.age_max || "Any" %></dd>
  </dl>

  <h2>About me</h2>
  <% if @profile.bio.present? %>
    <%= simple_format(@profile.bio) %>
  <% else %>
    <p>No bio yet.</p>
  <% end %>

  <section class="companion-feedback" aria-labelledby="companion-feedback-heading">
    <h2 id="companion-feedback-heading">What <%= @companion.name %> thinks</h2>
    <% if @feedback %>
      <p><%= @feedback.body %></p>
    <% else %>
      <p>Ask <%= @companion.name %> for tips on your profile.</p>
    <% end %>
    <%= button_to "What do you think?", profile_feedback_path %>
  </section>

  <p><%= link_to "Edit profile", edit_profile_path %></p>
  <p>
    <%= button_to "Delete profile",
                  profile_path,
                  method: :delete,
                  data: { turbo_confirm: "Are you sure?" } %>
  </p>
  <p><%= link_to "Blocked people", blocks_path %></p>
  <p><%= link_to "My reports", reports_path %></p>
</section>
