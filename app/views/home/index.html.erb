<div class="home">
  <h1>Welcome to WingmAIn</h1>
  <p class="home-lead">A dating app with an AI wingman to help you browse profiles and break the ice.</p>

  <% if user_signed_in? %>
    <div class="home-cards">
      <div class="home-card">
        <h2><%= link_to "Discover", swipes_path %></h2>
        <p>Swipe through profiles and see what your companion thinks.</p>
      </div>
      <div class="home-card">
        <h2><%= link_to "Matches", matches_path %></h2>
        <p>Check your mutual likes and start a conversation.</p>
      </div>
      <div class="home-card">
        <h2><%= link_to "Your companion", companion_path %></h2>
        <p>Chat with your wingman or tweak their personality.</p>
      </div>
      <div class="home-card">
        <h2><%= link_to "Your profile", profile_path %></h2>
        <p>Update your bio, photo, and dating preferences.</p>
      </div>
    </div>
  <% end %>
</div>
